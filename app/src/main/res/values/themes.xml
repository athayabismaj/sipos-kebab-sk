<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme (used for window background, no action bar) -->
    <style name="Theme.SiposKebabSk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Splash screen theme using SplashScreen API -->
    <style name="Theme.SiposKebabSk.Splash" parent="Theme.SplashScreen">
        <!-- Centered icon shown on splash -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <!-- Orange brand background -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Theme to switch to after splash completes -->
        <item name="postSplashScreenTheme">@style/Theme.SiposKebabSk</item>
    </style>

</resources>